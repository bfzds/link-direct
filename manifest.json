{
  "manifest_version": 3,
  "name": "链接直达助手",
  "description": "自动识别被网站包装的中转链接与短链接，点击一步直达真实地址；纯文本网址自动变成可点击链接。",
  "version": "0.2.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["rules.js", "dom-engine.js", "shadow-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["rules.js", "dom-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "链接直达助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
